{
  "redirects": [
    { "source": "/staff", "destination": "/staff/", "permanent": true },
    { "source": "/manager", "destination": "/manager/", "permanent": true },
    { "source": "/admin", "destination": "/manager/", "permanent": false },
    { "source": "/deputy", "destination": "/staff/", "permanent": false },
    { "source": "/deputy/", "destination": "/staff/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/staff/:path*", "destination": "https://francis-deli-timeclock.vercel.app/staff/:path*" },
    { "source": "/manager/:path*", "destination": "https://francis-deli-timeclock.vercel.app/manager/:path*" },
    { "source": "/deputy/:path*", "destination": "https://francis-deli-timeclock.vercel.app/deputy/:path*" }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon-16x16.png|favicon-32x32.png|favicon-48x48.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ]
}
